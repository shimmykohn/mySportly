<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array><dict><key>CFBundleURLSchemes</key><array><string>mysportly</string></array></dict></array>
	<key>SportlyCloudEnabled</key><true/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array><string>app.iska.mysportly.source-refresh</string></array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- User-entered providers can require HTTP. Adding a fine-grained ATS
		     key such as NSAllowsLocalNetworking overrides this permission. -->
		<key>NSAllowsArbitraryLoads</key><true/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>audio</string>
		<string>processing</string>
	</array>
</dict>
</plist>
